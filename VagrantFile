# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|

  #Wazuh Server VM in ubuntu
  config.vm.define "wazuh" do |wazuh|
    wazuh.vm.box = "bento/ubuntu-22.04"
    wazuh.vm.hostname = "wazuh-server"
    wazuh.vm.network "private_network", ip: "192.168.56.10"
    wazuh.vm.network "forwarded_port", guest: 443, host: 8443, host_ip: "127.0.0.1"
    wazuh.vm.network "forwarded_port", guest: 22, host: 2222, host_ip: "127.0.0.1", id: "ssh", auto_correct: false

    wazuh.vm.provider "virtualbox" do |vb|
      vb.name = "SOC-Wazuh-Server"
      vb.memory = "6144"
      vb.cpus = 4
      # Fix MTU / packet drop on Windows hosts:
      vb.customize ["modifyvm", :id, "--nictype1", "virtio"]
      vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
    end
  end

 # Windows Server VM
  config.vm.define "ad_dc" do |ad|
    ad.vm.box = "StefanScherer/windows_2022"
    ad.vm.hostname = "dc01"
    ad.vm.network "private_network", ip: "192.168.56.20"
    ad.vm.communicator = "winrm"

    ad.vm.provider "virtualbox" do |vb|
      vb.name = "SOC-AD-DC01"
      vb.memory = "4096"
      vb.cpus = 2
    end
  end

  # Kali linux vm
  config.vm.define "kali" do |kali|
    kali.vm.box = "kalilinux/rolling"
    kali.vm.hostname = "kali-attacker"
    kali.vm.network "private_network", ip: "192.168.56.30"

    kali.vm.provider "virtualbox" do |vb|
      vb.name = "SOC-Kali-Attacker"
      vb.memory = "2048"
      vb.cpus = 2
    end
  end

end